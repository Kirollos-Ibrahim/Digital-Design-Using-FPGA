module top_module(
    input wire clk,
    input wire resetn,
    input wire [1:0] byteena,
    input wire [15:0] d,
    output reg [15:0] q
);
    always@(posedge clk) begin
        if(~resetn) q <= 16'b0;
        else case(byteena)
            2'b00:   q       <= q;
            2'b01:   q[7:0]  <= d[7:0];
            2'b10:   q[15:8] <= d[15:8];
            2'b11:   q[15:0] <= d[15:0];
            default: q <= q;
        endcase
    end
endmodule
