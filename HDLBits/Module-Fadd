module top_module(
    input wire  [31:0] a,
    input wire  [31:0] b,
    output wire [31:0] sum
);
    wire w0;
    add16 add16_0 (.a(a[15:0]),  .b(b[15:0]),  .cin(1'b0), .sum(sum[15:0]) , .cout(w0));
    add16 add16_1 (.a(a[31:16]), .b(b[31:16]), .cin(w0),   .sum(sum[31:16]), .cout(1'b0));
endmodule

module add1(
    input wire  a,
    input wire  b,
    input wire  cin,
    output wire sum,
    output wire cout
);
    assign {cout, sum} = a + b + cin;
endmodule
